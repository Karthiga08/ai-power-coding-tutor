# Copy to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://tutor:tutor@db:5432/ai_coding_tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=ai_coding_tutor

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# "docker" (local sandbox containers) or "judge0" (hosted API, for free
# hosts without Docker — see FREE_HOSTING.md)
CODE_RUNNER_BACKEND=docker
CODE_RUNNER_IMAGE=ai-tutor-runner-python:latest
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

VITE_API_URL=http://localhost:8000

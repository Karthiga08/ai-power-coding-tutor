# Copy to .env on the server (cp .env.hetzner.example .env) and fill in.
# Never commit the real .env.

# Public hostname pointing at the server's IP (A record). Caddy gets a
# Let's Encrypt certificate for it automatically.
DOMAIN=tutor.example.com
ACME_EMAIL=you@example.com

# Postgres (internal only — not exposed to the internet)
POSTGRES_USER=tutor
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=ai_coding_tutor

# Auth
# generate: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider: "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Code runner sandbox (images are built by deploy/deploy.sh)
CODE_RUNNER_IMAGE=ai-tutor-runner-python:latest
CODE_RUNNER_IMAGE_JAVA=ai-tutor-runner-java:latest
CODE_RUNNER_IMAGE_RUBY=ai-tutor-runner-ruby:latest
CODE_RUNNER_TIMEOUT_SECONDS=10
CODE_RUNNER_MEMORY_LIMIT=128m
CODE_RUNNER_MEMORY_LIMIT_JAVA=256m
CODE_RUNNER_CPU_QUOTA=50000

# Production image: build the Vite app, then serve the static files from
# Caddy (which also proxies /api to the backend — see deploy/Caddyfile).
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Same-origin API: Caddy routes /api/* to the backend, so the browser can
# call relative URLs and the build doesn't need to know the domain.
ENV VITE_API_URL=/
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv

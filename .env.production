# Production Environment Variables
# Copy this to .env and fill in real values when deploying to production
# NEVER commit the filled version to Git

# Database (Render PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/ai_coding_tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=ai_coding_tutor

# JWT Configuration
JWT_SECRET=your-long-random-secret-key-min-32-chars-please-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration (Gemini is cheaper)
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Frontend API URL
VITE_API_URL=https://ai-tutor-backend.onrender.com

# CORS Configuration
CORS_ORIGINS=https://your-frontend-url.vercel.app,https://your-domain.com

# Code Runner Configuration
CODE_RUNNER_IMAGE=ai-tutor-runner-python:latest
CODE_RUNNER_IMAGE_JAVA=ai-tutor-runner-java:latest
CODE_RUNNER_IMAGE_RUBY=ai-tutor-runner-ruby:latest
CODE_RUNNER_TIMEOUT_SECONDS=10
CODE_RUNNER_MEMORY_LIMIT=128m
CODE_RUNNER_MEMORY_LIMIT_JAVA=256m
CODE_RUNNER_CPU_QUOTA=50000
